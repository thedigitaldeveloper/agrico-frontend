# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ...but the template is meant to be committed.
!.env.example

# local debug dumps
.d.html

# scraped reference data — 26MB of third-party payloads, regenerable from
# data-scrape/README.md, and not shipped with the app
/data-scrape/
/content-rewrite/
/content-draft/
/scratch/



# Local browser review captures
/docs/design/qa/*.png

# Local server output
/logs/
