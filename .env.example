# --- Site ---------------------------------------------------------------
# REQUIRED. `next build` fails without it rather than falling back to localhost,
# which would emit a disallow-all robots.txt and drop the site out of Google.
# Canonical public origin. Used for sitemap, canonical URLs, OG tags, JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3003
NEXT_PUBLIC_SITE_NAME=Agrico

# NOTE: robots.txt, canonical URLs and the sitemap are generated at BUILD time,
# so NEXT_PUBLIC_SITE_URL must be correct when `next build` runs.
# Enable only for the approved public Agrico domain at launch.
SITE_INDEXING_ENABLED=false

# --- CMS ----------------------------------------------------------------
# REQUIRED. Origin the BROWSER reaches for media (images, brochures).
NEXT_PUBLIC_CMS_URL=http://localhost:1340

# Origin the SERVER fetches data from. Leave unset to reuse NEXT_PUBLIC_CMS_URL.
# Point this at a private address in production so SSR skips the public proxy.
CMS_INTERNAL_URL=http://127.0.0.1:1340

# Read-only API token. Strapi admin -> Settings -> API Tokens, type "Read-only".
# Server-only: never prefix with NEXT_PUBLIC_.
#
# Needed for ONE thing: reading the lead list behind /dashboard/leads, which the
# public role is not allowed to fetch. Everything else the site renders is read
# without it, because Strapi authorises a request against the token's own
# permissions rather than the public role's — and a read-only token covers
# neither the custom findBySlug routes nor any create.
#
# Leaving this empty is safe: the site builds and serves normally, only the
# leads dashboard comes back empty. See ADMIN_EMAILS for who may open that page.
CMS_API_TOKEN=

# --- Admin access -------------------------------------------------------
# Comma-separated addresses allowed into /dashboard/leads, matched exactly and
# case-insensitively. Server-only — never prefix with NEXT_PUBLIC_, since this
# decides who can read every lead the business has.
#
# Unset means nobody is an admin and the page is unreachable. That is the safe
# default: leave it unset rather than guessing.
ADMIN_EMAILS=

# --- Revalidation -------------------------------------------------------
# Shared secret the CMS sends to /api/revalidate so content edits go live
# immediately instead of waiting for the ISR window.
REVALIDATE_SECRET=

# --- Contact & WhatsApp -------------------------------------------------
# OPTIONAL. These live in the CMS now — Content Manager -> Site Setting — so the
# number a campaign points at can change without a rebuild. Both are required
# there, and the CMS value always wins over anything set here.
#
# Set these only as a backstop for a CMS outage, and only to the real values.
# Leaving them unset renders a dead link, which is visible and harmless; a
# placeholder would route real enquiries to whoever owns those digits.
#
# Country code first, digits only — no +, spaces or dashes.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=
